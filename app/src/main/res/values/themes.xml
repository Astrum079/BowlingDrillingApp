<?xml version="1.0" encoding="utf-8"?>
<!-- app/src/main/res/values/themes.xml – 앱 테마 -->
<resources>
    <style name="Theme.BowlingDrilling" parent="Theme.Material3.DayNight.NoActionBar" />
    <style name="PreviewOverlayText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">top|start</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">#0F172A</item>
        <item name="android:textStyle">bold</item>
        <!-- 도면과 비율이 맞아야 하므로 의도적으로 sp가 아닌 dp를 쓴다 (기기 글자 크기 설정에 영향받지 않도록) -->
        <item name="android:textSize">24dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>