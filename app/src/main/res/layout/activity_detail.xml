<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="고객 정보" android:textAppearance="?attr/textAppearanceTitleMedium" android:textStyle="bold" />
                <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="이름" />
                <EditText android:id="@+id/etPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="전화번호" />
                <EditText android:id="@+id/etDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="측정일" />
                <EditText android:id="@+id/etNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="메모" />
                <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <RadioButton android:id="@+id/rbRightHand" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:checked="true" android:text="오른손" />
                    <RadioButton android:id="@+id/rbLeftHand" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="왼손" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- 중지 -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="중지" android:textSize="20sp" android:textAppearance="?attr/textAppearanceTitleMedium" android:textStyle="bold" />
                    <EditText android:id="@+id/etMidSize" android:layout_width="110dp" android:layout_height="wrap_content" android:hint="홀 사이즈" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="40dp" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X"/><CheckBox android:id="@+id/cbMidXNegative" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:padding="0dp"/></LinearLayout>
                    
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <EditText android:id="@+id/etMidXNum" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분자" android:inputType="number" />
                        <EditText android:id="@+id/etMidXDen" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분모" android:inputType="number" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Y"/><CheckBox android:id="@+id/cbMidYNegative" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:padding="0dp"/></LinearLayout>
                    
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <EditText android:id="@+id/etMidYNum" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분자" android:inputType="number" />
                        <EditText android:id="@+id/etMidYDen" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분모" android:inputType="number" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- 약지 -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="약지" android:textSize="20sp" android:textAppearance="?attr/textAppearanceTitleMedium" android:textStyle="bold" />
                    <EditText android:id="@+id/etRingSize" android:layout_width="110dp" android:layout_height="wrap_content" android:hint="홀 사이즈" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="40dp" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X"/><CheckBox android:id="@+id/cbRingXNegative" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:padding="0dp"/></LinearLayout>
                    
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <EditText android:id="@+id/etRingXNum" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분자" android:inputType="number" />
                        <EditText android:id="@+id/etRingXDen" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분모" android:inputType="number" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Y"/><CheckBox android:id="@+id/cbRingYNegative" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:padding="0dp"/></LinearLayout>
                    
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <EditText android:id="@+id/etRingYNum" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분자" android:inputType="number" />
                        <EditText android:id="@+id/etRingYDen" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분모" android:inputType="number" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- 엄지 -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="엄지" android:textAppearance="?attr/textAppearanceTitleMedium" android:textStyle="bold" android:textSize="20sp" />
                    <EditText android:id="@+id/etThumbSize" android:layout_width="110dp" android:layout_height="wrap_content" android:hint="홀 사이즈" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="40dp" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X"/><CheckBox android:id="@+id/cbThumbXNegative" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:padding="0dp"/></LinearLayout>
                    
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <EditText android:id="@+id/etThumbXNum" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분자" android:inputType="number" />
                        <EditText android:id="@+id/etThumbXDen" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분모" android:inputType="number" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Y"/><CheckBox android:id="@+id/cbThumbYNegative" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:padding="0dp"/></LinearLayout>
                    
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <EditText android:id="@+id/etThumbYNum" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분자" android:inputType="number" />
                        <EditText android:id="@+id/etThumbYDen" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분모" android:inputType="number" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- 스팬 -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" android:textAlignment="center">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="스팬" android:textSize="20sp" android:textAppearance="?attr/textAppearanceTitleMedium" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="엄지-중지" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <EditText android:id="@+id/etSpanMidInt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="정수" android:inputType="number" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <EditText android:id="@+id/etSpanMidNum" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분자" android:inputType="number" />
                                <EditText android:id="@+id/etSpanMidDen" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분모" android:inputType="number" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="엄지-약지" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <EditText android:id="@+id/etSpanRingInt" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_weight="1" android:hint="정수" android:inputType="number" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <EditText android:id="@+id/etSpanRingNum" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분자" android:inputType="number" />
                                <EditText android:id="@+id/etSpanRingDen" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분모" android:inputType="number" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="브릿지" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <EditText android:id="@+id/etBridgeInt" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_weight="1" android:hint="정수" android:inputType="number" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <EditText android:id="@+id/etBridgeNum" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분자" android:inputType="number" />
                                <EditText android:id="@+id/etBridgeDen" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:hint="분모" android:inputType="number" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="입력 미리보기" android:textAppearance="?attr/textAppearanceTitleMedium" android:textStyle="bold" />
        <FrameLayout android:id="@+id/previewCanvas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:background="#F8FAFC">
            <ImageView android:id="@+id/ivPreviewSheet" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:contentDescription="지공 도면" android:scaleType="fitCenter" android:src="@drawable/drilling_sheet_bg"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewMidSize" tools:text="00" />
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewMidXNum" tools:text="00"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewMidXDen" tools:text="00"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewMidYNum" tools:text="00"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewMidYDen" tools:text="00"/>

            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewRingSize" tools:text="00"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewRingXNum" tools:text="00"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewRingXDen" tools:text="00"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewRingYNum" tools:text="00"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewRingYDen" tools:text="00"/>

            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewThumbSize" tools:text="00"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewThumbXNum" tools:text="00"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewThumbXDen" tools:text="00"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewThumbYNum" tools:text="00"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewThumbYDen" tools:text="00"/>

            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewSpanMidInt" tools:text="00"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewSpanMidNum" tools:text="00"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewSpanMidDen" tools:text="00"/>

            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewSpanRingInt" tools:text="00"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewSpanRingNum" tools:text="00"/>
            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewSpanRingDen" tools:text="00"/>

            <TextView style="@style/PreviewOverlayText" android:id="@+id/tvPreviewHand" tools:text="RH"/>
        </FrameLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="56dp" android:text="지공 데이터 저장하기" />
    </LinearLayout>
</ScrollView>